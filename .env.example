# ===== 模型配置 =====
# mock: 零依赖离线演示（默认）；api: 调真实模型
AQA_MODEL_MODE=mock

# 文本模型：DeepSeek（国内直连，OpenAI 兼容协议）
AQA_TEXT_BASE_URL=https://api.deepseek.com/v1
AQA_TEXT_API_KEY=
AQA_TEXT_MODEL=deepseek-flash

# 视觉模型：默认复用同一个 DeepSeek 端点（deepseek-flash 支持图像输入）。
# 有 Qwen-VL / 本地 VLM 时改这三项即可；vision key 留空且端点相同则自动复用文本 key。
AQA_VISION_BASE_URL=https://api.deepseek.com/v1
AQA_VISION_API_KEY=
AQA_VISION_MODEL=deepseek-flash

# 推理模型会先花 token 思考，预算给小了会返回空内容（finish_reason=length）
AQA_MAX_TOKENS=8192
AQA_MAX_TOKENS_VISION=2048

# 判定优先级：state_first = 设备状态可解析时按状态判定（便宜且确定），视觉兜底
#              vision_first = 一律交给视觉模型
AQA_JUDGE_MODE=state_first

# 成本核算（元 / 百万 token），只影响报告里的估算值
AQA_PRICE_IN=1.0
AQA_PRICE_OUT=4.0

# 若已本地部署 vLLM / Ollama，改成内网地址即可：
# AQA_TEXT_BASE_URL=http://127.0.0.1:8000/v1
# AQA_VISION_BASE_URL=http://127.0.0.1:8001/v1

# ===== 适配器 =====
# 设备：mock | sim | adb | serial（sim = 真实运行 AI 生成的产品进程）
AQA_DEVICE_KIND=mock
AQA_DEVICE_ID=mock-device-01
# AQA_DEVICE_KIND=serial
# AQA_SERIAL_PORT=COM3
# AQA_FLASH_CMD=esptool.py --port COM3 write_flash 0x0 firmware.bin

# 构建：mock | package | docker
AQA_BUILD_KIND=mock

# 缺陷跟踪：local | github
AQA_BUGTRACKER_KIND=local
# AQA_BUG_REPO=your-org/your-repo

# ===== 流程控制 =====
AQA_MAX_RETRIES=2
AQA_CASE_TIMEOUT=120
AQA_REQUIRE_HUMAN_CONFIRM=true
# mock 模式下自动确认缺陷，用于演示完整闭环
AQA_AUTO_CONFIRM=true
